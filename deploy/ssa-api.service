[Unit]
Description=SSA Monitor Processos — API de leitura (FastAPI)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=ssa
Group=ssa
WorkingDirectory=/opt/ssa-monitor
EnvironmentFile=/opt/ssa-monitor/.env
# 0.0.0.0: igual ao ssa-dashboard.service — o nginx compartilhado roda em
# container Docker e alcança o host via 172.17.0.1, não 127.0.0.1. Quem
# restringe o acesso externo é o UFW (allow só das redes docker, deny o
# resto), não o bind address.
Environment=API_HOST=0.0.0.0
Environment=API_PORT=8002
ExecStart=/opt/ssa-monitor/.venv/bin/python -m api.main
Restart=always
RestartSec=10
StandardOutput=append:/var/log/ssa-monitor/api.log
StandardError=append:/var/log/ssa-monitor/api.log

[Install]
WantedBy=multi-user.target
