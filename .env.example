# ─────────────────────────────────────────────
# Banco de Dados MySQL
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_USER=ssa_user
DB_PASSWORD=sua_senha_aqui
DB_NAME=ssa_monitor_processos

# ─────────────────────────────────────────────
# API de resolução de CAPTCHA (2captcha.com)
# ─────────────────────────────────────────────
CAPTCHA_API_KEY=sua_chave_2captcha_aqui
CAPTCHA_API_ENVIAR_URL=https://2captcha.com/in.php
CAPTCHA_API_RESULTADO_URL=https://2captcha.com/res.php

# ─────────────────────────────────────────────
# Dashboard Web
# ─────────────────────────────────────────────
# 127.0.0.1: só aceita conexões locais (o nginx faz o proxy_pass).
# NUNCA usar 0.0.0.0 em produção — deixaria a porta acessível direto da
# internet, sem passar pelo nginx (HTTPS + allowlist de IP do escritório).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# ─────────────────────────────────────────────
# Sessão do Dashboard (login multiusuário)
# ─────────────────────────────────────────────
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=gere_um_valor_aleatorio_aqui

# ─────────────────────────────────────────────
# Criptografia de credenciais dos órgãos (login_acesso/senha_acesso)
# ─────────────────────────────────────────────
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=gere_uma_chave_fernet_aqui

# ─────────────────────────────────────────────
# Webhook para o Laravel (fire-and-forget)
# ─────────────────────────────────────────────
# Deixe em branco para desativar (Laravel ainda não existe em produção)
LARAVEL_WEBHOOK_URL=
LARAVEL_WEBHOOK_TOKEN=

# ─────────────────────────────────────────────
# API de leitura (FastAPI) — consumida pelo Laravel
# ─────────────────────────────────────────────
# Em dev, 127.0.0.1 já basta. Em produção atrás de nginx em Docker (que
# só alcança o host via 172.17.0.1, não 127.0.0.1), use 0.0.0.0 e proteja
# a porta pelo UFW (allow só das redes docker, deny o resto) — mesmo
# padrão já usado pelo DASHBOARD_HOST em produção.
API_HOST=127.0.0.1
API_PORT=8002
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
API_INTERNAL_TOKEN=gere_um_valor_aleatorio_aqui
# Tamanho do pool de conexões MySQL da API (padrão 10, máximo 32)
API_DB_POOL_SIZE=10
